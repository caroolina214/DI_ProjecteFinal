<Window x:Class="MilAventures.View.Views.Guides.GuideDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="580" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ColorGris}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Títol -->
            <TextBlock Grid.Row="0" Text="{Binding DialogTitle}"
                       Style="{StaticResource EstilMiniTitol}"
                       Margin="0,0,0,24"/>

            <!-- Foto -->
            <StackPanel Grid.Row="1" Orientation="Vertical"
                        Margin="0,0,0,20" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36"
                        BorderBrush="{StaticResource ColorGroc}"
                        Background="{StaticResource ColorBlanc}"
                        BorderThickness="2" Margin="0,0,0,20">  
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Ellipse Width="72" Height="72" Fill="White"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                </Border>
                <Button Style="{StaticResource BtnSistemaOutlined}"
                        Command="{Binding SelectPhotoCommand}"
                        Content="Seleccionar foto" />
            </StackPanel>

            <!-- Nom -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Nom *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <!-- Cognoms -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Cognoms *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <!-- Email -->
            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <TextBlock Text="Email" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <!-- Telèfon -->
            <StackPanel Grid.Row="5" Margin="0,0,0,16">
                <TextBlock Text="Telèfon" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <!-- Especialitat -->
            <StackPanel Grid.Row="6" Margin="0,0,0,16">
                <TextBlock Text="Especialitat" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Specialty, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <!-- Titulacions -->
            <StackPanel Grid.Row="7" Margin="0,0,0,16">
                <TextBlock Text="Titulacions" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Credentials, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         Height="72" TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Nivell experiència -->
            <StackPanel Grid.Row="8" Margin="0,0,0,24">
                <TextBlock Text="Nivell d'experiència" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ExperienceLevel, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <!-- Actiu + Botons -->
            <Grid Grid.Row="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Content="Guia actiu"
                          IsChecked="{Binding Status}"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource FontLabel}"
                          Foreground="{StaticResource ColorNegre}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnBorrarOutlined}"
                            Command="{Binding CancelCommand}"
                            Content="Cancel·lar"
                            Margin="0,0,12,0"/>
                    <Button Style="{StaticResource BtnAcceptarFilled}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" Margin="0,0,6,0"/>
                            <TextBlock Text="Desar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>