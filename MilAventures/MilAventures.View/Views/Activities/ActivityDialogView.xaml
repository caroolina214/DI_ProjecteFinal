<Window x:Class="MilAventures.View.Views.Activities.ActivityDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding DialogTitle}"
        Height="620" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ColorGris}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" >
        <Grid Margin="32" Height="765">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding DialogTitle}"
                       Style="{StaticResource EstilMiniTitol}" Margin="0,0,0,24"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Títol *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Descripció" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         Height="72" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data inici *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding InitDate}"
                                FontFamily="{StaticResource FontText}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Data fi *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding EndDate}"
                                FontFamily="{StaticResource FontText}" FontSize="14"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dificultat *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Difficulties}"
                              SelectedItem="{Binding Difficulty}"
                              Style="{StaticResource DropdownStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="{StaticResource FontText}" FontSize="16"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Màx. participants *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MaxParticipants, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="5" Margin="0,0,0,16">
                <TextBlock Text="Punt inici/fi" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding StartEndPoint, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,16">
                <TextBlock Text="Preu per persona (€) *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PricePerPerson, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource InputStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Margin="0,0,0,16">
                <TextBlock Text="Categoria *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="code"
                          Style="{StaticResource DropdownStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Margin="0,0,0,24">
                <TextBlock Text="Guia" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Guides}"
                          SelectedItem="{Binding SelectedGuide}"
                          Style="{StaticResource DropdownStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="{StaticResource FontText}" FontSize="16">
                                <Run Text="{Binding name}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding surname}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,64,0,-63">
                <Button Style="{StaticResource BtnBorrarOutlined}"
                        Command="{Binding CancelCommand}"
                        Content="Cancel·lar" Margin="0,0,12,0" Height="46"/>
                <Button Style="{StaticResource BtnAcceptarFilled}"
                        Command="{Binding SaveCommand}" Height="41">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Desar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>