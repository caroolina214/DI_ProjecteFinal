<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="MilAventures.View.Views.Categories.CategoryListView"
             Background="{StaticResource ColorBlanc}" av:DesignHeight="226.517" av:DesignWidth="797.97">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Capçalera -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Categories"
                       Style="{StaticResource EstilSubtitol}"/>


            <Button Grid.Column="1" Style="{StaticResource BtnSistemaFilled}" Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" Margin="0,0,6,0"/>
                    <TextBlock Text="Nova categoria"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- Barra de cerca -->
        <TextBox Grid.Row="1" Margin="0,0,0,16"
         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource SearchBarStyle}"/>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
          ItemsSource="{Binding Categories}"
          SelectedItem="{Binding SelectedCategory}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Codi" Binding="{Binding code}" Width="150"/>
                <DataGridTextColumn Header="Descripció" Binding="{Binding description}" Width="*"/>
                <DataGridTemplateColumn Header="Accions" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BtnEditarFilled}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        Margin="0,0,8,0"
                                >
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✏️" Margin="0,0,6,0"/>
                                        <TextBlock Text="Editar"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnBorrarFilled}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                >
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                                        <TextBlock Text="Eliminar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>