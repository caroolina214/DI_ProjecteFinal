<Window x:Class="MilAventures.View.Views.Categories.CategoryDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding DialogTitle}"
        Height="403" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ColorGris}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Títol -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}"
                   Style="{StaticResource EstilMiniTitol}"
                   Margin="0,0,0,24" Height="29" VerticalAlignment="Bottom"/>

        <!-- Camp Codi -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Codi *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource FontText}"
                     FontSize="14" Padding="10,8"
                     BorderBrush="{StaticResource ColorGris}"
                     BorderThickness="1"/>
        </StackPanel>

        <!-- Camp Descripció -->
        <StackPanel Grid.Row="2" Margin="0,0,0,24">
            <TextBlock Text="Descripció" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource FontText}"
                     FontSize="14" Padding="10,8"
                     BorderBrush="{StaticResource ColorGris}"
                     BorderThickness="1"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Botons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            
            <Button Style="{StaticResource BtnCancelFilled}" VerticalContentAlignment="Center"
                    Command="{Binding CancelCommand}" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cancel·lar"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource BtnAcceptarFilled}" VerticalContentAlignment="Center"
                    Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="Desar"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>