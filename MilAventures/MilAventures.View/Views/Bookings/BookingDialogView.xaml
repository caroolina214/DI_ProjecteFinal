<Window x:Class="MilAventures.View.Views.Bookings.BookingDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding DialogTitle}"
        Height="700" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource ColorGris}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Títol -->
            <TextBlock Grid.Row="0" Text="{Binding DialogTitle}"
                       Style="{StaticResource EstilMiniTitol}" Margin="0,0,0,24"/>

            <!-- Client i Estat -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Client *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}"
                              Style="{StaticResource DropdownStyle}"
                              IsEnabled="{Binding IsEditable}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource FontText}" FontSize="16">
                                    <Run Text="{Binding name}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding surname}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Estat *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableStatuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              DisplayMemberPath="code"
                              Style="{StaticResource DropdownStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Participants i Notes -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Participants *" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Participants, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             IsEnabled="{Binding IsEditable}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Notes" Style="{StaticResource EstilLabel}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Botons afegir línies -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Línies de reserva"
                           Style="{StaticResource EstilLabel}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource BtnAcceptarOutlined}"
                        Command="{Binding AddActivityLineCommand}"
                        IsEnabled="{Binding IsEditable}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="20" Margin="0,0,4,0"/>
                        <TextBlock Text="Activitat"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource BtnSistemaOutlined}"
                        Command="{Binding AddEquipmentLineCommand}"
                        IsEnabled="{Binding IsEditable}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="20" Margin="0,0,4,0"/>
                        <TextBlock Text="Equipament"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Capçalera línies -->
            <Grid Grid.Row="4" Margin="0,15,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Element"
                           Style="{StaticResource EstilLabel}" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="Quantitat"
                           Style="{StaticResource EstilLabel}" FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Preu unit."
                           Style="{StaticResource EstilLabel}" FontSize="13" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Línies -->
            <ItemsControl Grid.Row="5" ItemsSource="{Binding Lines}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ColorBlanc}"
                                Margin="0,0,0,6" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <!-- Activitat -->
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableActivities}"
                                          SelectedItem="{Binding SelectedActivity}"
                                          Style="{StaticResource DropdownStyle}"
                                          IsEnabled="{Binding DataContext.IsEditable,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          Visibility="{Binding IsActivity,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding title}"
                                                       FontFamily="{StaticResource FontText}" FontSize="14"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Equipament -->
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableEquipments}"
                                          SelectedItem="{Binding SelectedEquipment}"
                                          Style="{StaticResource DropdownStyle}"
                                          IsEnabled="{Binding DataContext.IsEditable,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          Visibility="{Binding IsEquipment,
                                              Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding title}"
                                                       FontFamily="{StaticResource FontText}" FontSize="14"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Quantitat -->
                                <TextBox Grid.Column="2"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"
                                         IsEnabled="{Binding DataContext.IsEditable,
                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>

                                <!-- Preu -->
                                <TextBox Grid.Column="4"
                                         Text="{Binding PriceAtMoment, StringFormat={}{0:F2}}"
                                         Style="{StaticResource InputStyle}"
                                         IsReadOnly="True"
                                         Background="{StaticResource ColorGris}"/>

                                <!-- Eliminar -->
                                <Button Grid.Column="6"
                                        Style="{StaticResource BtnBorrarFilled}"
                                        Command="{Binding DataContext.RemoveLineCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.IsEditable,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Padding="6">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Total i Botons -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL: " Style="{StaticResource EstilLabel}"
                               FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:F2} €}"
                               Style="{StaticResource EstilSubtitol}"
                               Foreground="{StaticResource ColorVerd}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnBorrarOutlined}"
                            Command="{Binding CancelCommand}"
                            Content="Cancel·lar" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource BtnAcceptarFilled}"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Desar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>