<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="MilAventures.View.Views.Bookings.BookingListView"
             Background="{StaticResource ColorBlanc}" av:DesignHeight="217.051" av:DesignWidth="682.154">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Reserves"
                       Style="{StaticResource EstilSubtitol}"/>
            <Button Grid.Column="1" Style="{StaticResource BtnSistemaFilled}"
                    Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Nova reserva"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBox Grid.Row="1" Margin="0,0,0,16"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource SearchBarStyle}"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Bookings}"
                  SelectedItem="{Binding SelectedBooking}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding id_booking}" Width="50"/>
                <DataGridTextColumn Header="Client"
                    Binding="{Binding Client.name}" Width="*"/>
                <DataGridTextColumn Header="Cognoms"
                    Binding="{Binding Client.surname}" Width="*"/>
                <DataGridTextColumn Header="Data"
                    Binding="{Binding created_at, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
                <DataGridTextColumn Header="Participants"
                    Binding="{Binding participants}" Width="90"/>
                <DataGridTextColumn Header="Total"
                    Binding="{Binding total_price, StringFormat=\{0:F2\} €}" Width="100"/>
                <DataGridTextColumn Header="Estat"
                    Binding="{Binding BookingStatus.code}" Width="100"/>

                <DataGridTemplateColumn Header="Accions" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BtnEditarFilled}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Editar"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnBorrarFilled}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Eliminar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>