<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="MilAventures.View.Views.Clients.ClientListView"
             Background="{StaticResource ColorBlanc}" av:DesignHeight="234.59" av:DesignWidth="842.947">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Capçalera -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Clients"
                       Style="{StaticResource EstilSubtitol}"/>
            <Button Grid.Column="1" Style="{StaticResource BtnSistemaFilled}"
                    Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Nou client"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cerca -->
        <TextBox Grid.Row="1" Margin="0,0,0,16"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource SearchBarStyle}"/>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Clients}"
                  SelectedItem="{Binding SelectedClient}">
            <DataGrid.Columns>
                <!-- Foto -->
                <DataGridTemplateColumn Header="Foto" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="36" Height="36" CornerRadius="18"
                                    BorderBrush="{StaticResource ColorGroc}"
                                    Background="{StaticResource ColorBlanc}"
                                    BorderThickness="1.5" ClipToBounds="True">
                                <Image Source="{Binding photo, Converter={StaticResource PhotoPathConverter}}"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Nom" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Cognoms" Binding="{Binding surname}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
                <DataGridTextColumn Header="Telèfon" Binding="{Binding phone}" Width="*"/>

                <!-- Actiu -->
                <DataGridTemplateColumn Header="Actiu" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{Binding status, Converter={StaticResource BoolToIconConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Accions -->
                <DataGridTemplateColumn Header="Accions" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BtnEditarFilled}"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Editar"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnBorrarFilled}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Eliminar"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>